{
  "name": "giokon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:copy": "node scripts/check-nonmedical-copy.mjs",
    "check:bom": "node scripts/check-bom.mjs",
    "web": "pnpm -F @giokon/web dev",
    "web:preview": "pnpm -F @giokon/web build && pnpm -F @giokon/web preview",
    "web:smoke": "pnpm -F @giokon/web build && pnpm -F @giokon/web smoke",
    "format": "prettier --write .",
    "check:font": "node scripts/check-font-class.mjs",
    "check:figma": "node scripts/check-figma-spec.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "test:audit": "node --test scripts/check-audit.test.mjs",
    "check:design": "node scripts/check-web-design.mjs",
    "check:web": "pnpm -F @giokon/web typecheck && pnpm -F @giokon/web lint && pnpm check:copy && pnpm check:design && pnpm -F @giokon/web build && pnpm -F @giokon/web smoke",
    "check:figma-web": "pnpm -F @giokon/web figma:audit",
    "check:a11y": "pnpm -F @giokon/web a11y"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "~6.0.2"
  }
}
