{
  "name": "giokon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:copy": "node scripts/check-nonmedical-copy.mjs",
    "web": "pnpm -F @giokon/web dev",
    "format": "prettier --write .",
    "check:font": "node scripts/check-font-class.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "~6.0.2"
  }
}
