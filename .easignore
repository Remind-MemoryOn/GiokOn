# EAS archives the monorepo root. This replaces .gitignore for uploads.
# Keep workspace manifests, source, assets and lockfile; regenerate native projects.
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/
.pnpm/
**/node_modules/

# Build outputs
dist/
dist-ssr/
build/
web-build/
coverage/
*.tsbuildinfo

# Local environment
.env
.env.*
!.env.example
!.env.*.example
*.local

# Expo / React Native
.expo/
.expo-shared/
android/
ios/
*.jks
*.keystore
*.pem
credentials.json
*service-account*.json
*.p8
*.p12
*.key
*.mobileprovision
google-services.json
*firebase-adminsdk*.json
apps/mobile/credentials/

# Deployment tooling
.netlify/
.vercel/
.railway/
supabase/.temp/
**/supabase/.temp/
*.apk
*.aab
*.ipa
.gradle/
.cxx/

# Temporary runtime files
tmp/
temp/
uploads/
*.db
*.sqlite
*.sqlite3

# Archives and generated exports
*.zip

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Figma 실측 감사 빌드(pnpm -F @giokon/web audit)
dist-audit/

# 배포용 산출물 사본·pnpm 스토어는 저장소에 넣지 않는다(2026-09-02)
deliverables/
.pnpm-store/

# 로컬 작업용 임시 폴더(HWP 추출 도구 등) — 저장소에 넣지 않는다
.tmp/

.vercel

# Local files never enter EAS; Firebase is supplied by its file environment variable.
.env*
**/credentials/
/docs/
/deliverables/

# Repository history and submission reference documents are not build inputs.
/.git/
/submissions/
