# 기억온 웹 (apps/web) — 클라이언트 환경변수 (Vite)
#
# 사용법: 이 파일을 apps/web/.env 로 복사한 뒤 실제 값을 채우세요.
#   cp apps/web/.env.example apps/web/.env
# .env 는 커밋되지 않습니다(.gitignore). 클라이언트에는 publishable 키만 노출합니다
# (레거시 anon 키 대체). secret 키는 절대 여기 두지 마세요 → supabase/.env.example 참고.

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
