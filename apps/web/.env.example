# 기억온 웹 (apps/web) — 클라이언트 환경변수 (Vite)
#
# 사용법: 이 파일을 apps/web/.env 로 복사한 뒤 실제 값을 채우세요.
#   cp apps/web/.env.example apps/web/.env
# .env 는 커밋되지 않습니다(.gitignore).
#
# 웹 앱이 읽는 환경변수는 아래 "딱 2개"뿐입니다. 별도의 ANON_KEY 변수는 없습니다.
#
# ⚠️ Vite 는 **`VITE_` 로 시작하는 변수만** 클라이언트 번들에 넣습니다(앱은 EXPO_PUBLIC_).
#    접두사를 빼면 코드에서 읽히지 않아 서버에 연결되지 않습니다 — 이름을 그대로 지키세요.
#    서버 전용 값(SUPABASE_SECRET_KEY · SUPABASE_JWKS_URL)은 supabase/.env 에 둡니다.
# ─────────────────────────────────────────────────────────────────────────────

# [1] 프로젝트 URL
#   Supabase 대시보드 → Project Settings → API → "Project URL" 값 그대로.
#   예: https://abcd1234efgh.supabase.co  (뒤에 / 슬래시 없이)
VITE_SUPABASE_URL="https://<서울-project-ref>.supabase.co"

# [2] 클라이언트(공개) 키
#   Supabase 대시보드 → Project Settings → API → "Project API keys".
#   ⚠️ 여기서 키 이름이 프로젝트 생성 시점에 따라 두 가지로 보일 수 있습니다:
#       · "anon" / "public"        (레거시 명칭)
#       · "Publishable key"        (신규 명칭, 보통 sb_publishable_... 로 시작)
#   둘 중 "공개(클라이언트)용 키"를 그대로 이 변수에 넣으면 됩니다. 이름이 anon이든
#   publishable이든 넣는 위치는 동일하게 VITE_SUPABASE_PUBLISHABLE_KEY 입니다.
#   ❌ "service_role" / "secret" 키는 절대 여기 두지 마세요(서버 전용 → supabase/.env.example).
VITE_SUPABASE_PUBLISHABLE_KEY="<anon 또는 publishable 키>"
