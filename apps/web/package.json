{
  "name": "@giokon/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test:auth": "node scripts/auth-isolation.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke": "node scripts/route-smoke.mjs",
    "figma:build": "vite build --mode figma --outDir dist-audit",
    "a11y": "pnpm figma:build && node scripts/a11y-audit.mjs",
    "figma:audit": "pnpm figma:build && pnpm figma:shots && node scripts/figma-audit.mjs && node scripts/run-figma-ink.mjs && node scripts/img-aspect-audit.mjs",
    "figma:shots": "node scripts/figma-shots.mjs",
    "img:audit": "pnpm figma:build && pnpm figma:shots && node scripts/img-aspect-audit.mjs"
  },
  "dependencies": {
    "@giokon/core": "workspace:*",
    "@giokon/data": "workspace:*",
    "@giokon/theme": "workspace:*",
    "@tanstack/react-query": "^5.101.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
