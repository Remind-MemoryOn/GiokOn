# 기억온 앱 (apps/mobile) — 클라이언트 환경변수 (Expo)
#
# 사용법: 이 파일을 apps/mobile/.env 로 복사한 뒤 실제 값을 채우세요.
#   cp apps/mobile/.env.example apps/mobile/.env
# .env 는 커밋되지 않습니다(.gitignore).
#
# 앱이 읽는 환경변수는 아래 "딱 2개"뿐입니다(웹의 VITE_* 와 동일 값, 접두사만 EXPO_PUBLIC_*).
# 둘 다 비어 있으면 앱은 목업 데이터로 동작하고(isSupabaseConfigured=false), 채우면
# 코드 변경 없이 실데이터(@giokon/data)로 전환됩니다.
#
# ⚠️ Expo는 EXPO_PUBLIC_ 접두사 변수만 클라이언트 번들에 노출합니다. 값은 빌드/번들
#    시점에 인라인되므로, EAS 빌드에서는 eas.json 의 env 또는 `eas secret:create` 로도
#    동일하게 넣어야 합니다(로컬 .env 는 Metro dev 서버에서만 읽힘).
# ─────────────────────────────────────────────────────────────────────────────

# [1] 프로젝트 URL
#   Supabase 대시보드 → Project Settings → API → "Project URL" 값 그대로.
#   예: https://abcd1234efgh.supabase.co  (뒤에 / 슬래시 없이)
EXPO_PUBLIC_SUPABASE_URL="https://<서울-project-ref>.supabase.co"

# [2] 클라이언트(공개) 키
#   Supabase 대시보드 → Project Settings → API → "Project API keys".
#   이름이 "anon"/"public"(레거시)이든 "Publishable key"(신규, sb_publishable_... 시작)이든
#   공개(클라이언트)용 키를 그대로 넣으면 됩니다.
#   ❌ "service_role" / "secret" 키는 절대 앱에 두지 마세요(서버 전용).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<anon 또는 publishable 키>"
