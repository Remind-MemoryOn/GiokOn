# 기억온 앱 (apps/mobile) — Expo 클라이언트 환경변수
#
# 사용법: 이 파일을 apps/mobile/.env 로 복사한 뒤 실제 값을 채우세요.
#   cp apps/mobile/.env.example apps/mobile/.env
# .env 는 커밋되지 않습니다(.gitignore).
#
# ⚠️ 접두사 규칙 — 가장 자주 겪는 함정
#   Expo(Metro)는 **`EXPO_PUBLIC_` 로 시작하는 변수만** 클라이언트 번들에 인라인합니다.
#   `EXPO_SUPABASE_URL` 처럼 접두사를 빼면 앱에서 `process.env` 로 읽을 수 없어
#   항상 undefined 가 되고, 앱은 서버에 연결하지 못합니다. 이름을 그대로 지키세요.
#
#   값은 **빌드 시점에 번들에 박힙니다**. 즉 여기 넣은 값은 앱을 뜯어보면 누구나 볼 수
#   있습니다 → 공개해도 되는 값만 둡니다. secret 키는 supabase/.env 로 가세요.
#
#   EAS 빌드에서는 로컬 .env 가 읽히지 않습니다. eas.json 의 `env` 또는
#   `eas env:create` 로 같은 이름을 등록해야 합니다(로컬 .env 는 Metro dev 서버 전용).
# ─────────────────────────────────────────────────────────────────────────────

# [필수 1/3] 프로젝트 URL — 앱이 DB·Auth·Storage 에 접속할 주소
#   용도: supabase-js 클라이언트 생성(모든 조회·저장·로그인·사진 업로드의 기준 주소).
#   위치: Supabase 대시보드 → Project Settings → API → "Project URL".
#   형식: 반드시 https:// 로 시작하고 끝에 슬래시(/) 없이.
#         ❗ 스킴(https://)을 빼면 상대 URL 로 요청이 나가 앱이 죽습니다
#            ("Failed to construct 'Response': The status provided (0)...").
#            그래서 앱은 형식을 검사해 잘못되면 연결을 건너뛰고 콘솔에 경고합니다.
EXPO_PUBLIC_SUPABASE_URL="https://<서울-project-ref>.supabase.co"

# [필수 2/3] 공개(클라이언트) 키 — 익명 요청의 신원
#   용도: 위 URL 로 보내는 모든 요청의 apikey 헤더. 로그인하면 그 위에 사용자 JWT 가
#         얹히고, 실제 권한은 **RLS 정책**이 결정합니다(키 자체에는 권한이 없습니다).
#   위치: Supabase 대시보드 → Project Settings → API → "Project API keys".
#         프로젝트 생성 시점에 따라 이름이 둘 중 하나로 보입니다:
#           · "anon" / "public"   (레거시 명칭)
#           · "Publishable key"   (신규 명칭, sb_publishable_... 로 시작)
#         둘 중 공개용 키를 그대로 넣으면 됩니다.
#   ❌ "service_role" / "secret" 키는 절대 여기 두지 마세요 → supabase/.env
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<anon 또는 publishable 키>"

# [선택] 웹 주소 — 설정 화면의 "개인정보처리방침 / 이용약관" 을 열 곳
#   용도: 법적 문서 화면은 웹이 담당하므로 앱은 링크만 엽니다.
#         비워 두면 "웹에서 확인할 수 있어요" 안내만 띄웁니다(동작에 지장 없음).
#   형식: 끝에 슬래시 없이. 앱이 뒤에 /privacy · /terms 를 붙입니다.
# EXPO_PUBLIC_WEB_URL="https://giokon.example.com"

# ── AI 음성 대화 (음성 중계 서버) ────────────────────────────────────────────
#
# 대화 음성은 **음성 중계(apps/voice-relay) 한 경로로만** 오갑니다(2026-09-23 중계 단일화):
#   앱 ─▶ voice-relay ─▶ Gemini Live ─▶ 서버 검증 ─▶ Clova TTS ─▶ 앱
# 앱은 Gemini 에 직접 접속하지 않고, Gemini 토큰도 받지 않습니다. 모델·시스템 지시·
# 출력 검증은 모두 중계 서버가 합니다(검증을 통과한 음성만 어르신께 재생됩니다).
#
# [필수 3/3] 음성 중계 서버 주소
#   용도: 대화 시작 시 앱이 이 주소로 WebSocket 연결을 열고, 첫 메시지로 로그인 JWT 를
#         보내 인증합니다(주소에 토큰을 싣지 않습니다).
#   형식: 반드시 wss:// 로 시작하고 경로가 정확히 /voice 여야 합니다.
#         쿼리(?)·해시(#)·계정정보(user@) 는 넣지 마세요.
#   ❗ 비어 있거나 형식이 틀리면 대화 시작 버튼에서 "대화를 시작할 수 없어요" 로 막힙니다.
#      (예전에는 비우면 Gemini 에 직접 붙는 경로로 조용히 넘어갔습니다 — 그 경로는 삭제했습니다.)
#   EAS 빌드에서는 eas.json `env` 또는 `eas env:create` 로 같은 이름을 등록해야 합니다.
EXPO_PUBLIC_VOICE_RELAY_URL="wss://<음성-중계-호스트>/voice"

# [선택] Edge Function 주소 재정의 — ⚠️ 이름이 옛 용도(live-token)로 남아 있습니다
#   용도: 앱은 더 이상 live-token 을 부르지 않습니다(위 중계 단일화). 이 값은 **네이버 로그인**이
#         끝의 `/live-token` 을 `/naver-auth` 로 바꿔 함수 주소를 찾는 데만 씁니다(src/auth/social.ts).
#   기본값: 비워 두면 <EXPO_PUBLIC_SUPABASE_URL>/functions/v1/naver-auth 를 사용합니다.
#           (엣지펑션을 다른 경로로 배포했을 때만 채우세요.)
# EXPO_PUBLIC_LIVE_TOKEN_URL=""

# [선택] 네이버 소셜 로그인 — 네이버 인가 화면을 열 때 쓰는 Client ID(공개값)
#   용도: nid.naver.com 인가 요청의 client_id. 세션 발급은 서버(naver-auth 함수)가
#         secret 으로 처리하므로 앱에는 ID 만 둡니다.
#   위치: developers.naver.com → 애플리케이션 정보 → Client ID
# EXPO_PUBLIC_NAVER_CLIENT_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# 앱에 두지 않는 값 (넣어도 동작하지 않고, 넣으면 위험합니다)
#
#   SUPABASE_SECRET_KEY   RLS 를 통째로 우회하는 서버 전용 키.
#                         앱에 두면 = 전 어르신 개인정보를 공개하는 것과 같습니다.
#                         → supabase/.env (Edge Function secrets)
#   SUPABASE_JWKS_URL     발급된 JWT 의 서명을 **검증**할 때 쓰는 공개 키 목록 주소.
#                         검증은 서버(Edge Function·외부 백엔드)가 합니다. 앱은 토큰을
#                         받아 쓰기만 하므로 필요 없습니다. → supabase/.env
#   GEMINI_API_KEY        Live API 본 키. 유출 시 대화·과금 전부 탈취됩니다.
#                         반드시 서버(Edge Function)에서만 보관 → supabase/.env
# ─────────────────────────────────────────────────────────────────────────────
