{
  "expo": {
    "name": "기억온",
    "slug": "giok-on",
    "scheme": "giokon",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#ffffff",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.giokon.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "어르신과의 회상 대화에서 말씀을 인식하기 위해 마이크를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "어르신 프로필 사진을 등록하기 위해 사진 보관함에 접근합니다."
      }
    },
    "android": {
      "package": "kr.giokon.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3877c5b5-40c9-4083-a1a3-4a6e37cf4d6b"
      }
    },
    "owner": "paulodybi"
  }
}
