# 기억온 Supabase — Edge Functions secrets (클라이언트 미노출)
#
# 사용법: 이 파일을 supabase/.env 로 복사 → 실제 값 채우기 → 배포 시 등록:
#   cp supabase/.env.example supabase/.env
#   supabase secrets set --env-file supabase/.env
# supabase/.env 는 커밋되지 않습니다(.gitignore). 이 키들은 Edge Function(서버)에서만
# 쓰이며 클라이언트 번들에 절대 넣지 마세요. (Edge Function 미배포 상태면 나중에 채워도 됨.)

# ── Supabase (서버) ──────────────────────────────────────────────────────────
# [1] 프로젝트 URL — 앱·웹과 같은 값(공개해도 되는 값).
#     용도: Edge Function 이 자기 프로젝트의 DB·Storage·Auth 를 호출할 기준 주소.
SUPABASE_URL="https://<서울-project-ref>.supabase.co"

# [2] secret 키(레거시 service_role 대체) — **RLS 를 통째로 우회**합니다.
#     용도: 사용자 권한 밖의 작업을 서버가 대신 할 때(예: 배치 정리, 관리자 처리).
#     위치: 대시보드 → Project Settings → API → "Secret key"(sb_secret_... ) 또는 service_role.
#     ❌ 앱·웹 번들에 절대 넣지 마세요. 이 키 하나면 전 어르신 개인정보가 열립니다.
#        (클라이언트 .env 에는 publishable 키만 둡니다.)
SUPABASE_SECRET_KEY="<secret-key>"

# [3] JWKS URL — 발급된 JWT 의 **서명을 검증**할 공개 키 목록 주소.
#     용도: Edge Function 이나 외부 백엔드가 "이 토큰이 진짜 우리 프로젝트가 발급한
#           것인가"를 확인할 때 씁니다. 비대칭 키(ES256/RS256)로 전환한 프로젝트에서
#           secret 없이 검증할 수 있게 해 줍니다.
#     위치: 대시보드 → Project Settings → API Keys → JWT Keys 에 표시된 URL.
#           보통 `<프로젝트 URL>/auth/v1/.well-known/jwks.json` 형태입니다.
#     참고: 공개 값이라 숨길 필요는 없지만, **검증은 서버가 하는 일**이라 앱에는 두지
#           않습니다(앱은 토큰을 받아 쓰기만 합니다).
SUPABASE_JWKS_URL="https://<서울-project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# ── Google Gemini (대화 AI · Live API) ───────────────────────────────────────
# 대화 음성 세션은 **Gemini Live API**(gemini-3.8-live)를 사용합니다.
#   용도: ① Edge Function `live-token` 이 ephemeral token 발급 시 본 키로 인증
#         ② (선택) 세션 종료 후 분석·일지 초안 등 일반 텍스트 호출
#   발급: https://aistudio.google.com/apikey  ("AIza..." 로 시작)
#   ⚠️ Live API preview 는 유료 과금(Billing 연결)이 필요할 수 있습니다 — 발급 후
#      콘솔에서 결제 수단·쿼터 확인. 키는 이 파일(서버)에만 둡니다.
GEMINI_API_KEY="AIza..."

# Live 세션 모델명(기본값). 승격/교체 시 여기만 바꿉니다(모델명 코드 고정 금지 원칙).
GEMINI_LIVE_MODEL="gemini-3.8-live"

# 음성 중계 서버의 검증 완료 문장 합성. Live 원음은 앱에 전달하지 않고,
# Gemini TTS가 반환한 24kHz WAV를 검증한 뒤 PCM만 앱에 전달합니다.
GEMINI_TTS_MODEL="gemini-3.8-flash-tts"
GEMINI_TTS_VOICE="Kore"

# (선택) 세션 종료 후 배치 분석·요양일지 초안용 텍스트 모델.
#       Live 모델은 Structured Outputs 미지원 → JSON 이 필요한 오프라인 호출은
#       Structured Outputs 를 지원하는 일반 텍스트 모델로 분리합니다.
# GEMINI_TEXT_MODEL=""

# ── OpenAI (LLM · STT: gpt-4o-transcribe) — 폴백/보완용 ──────────────────────
# 키는 1개. 인증은 HTTP 헤더  Authorization: Bearer <OPENAI_API_KEY>.
# 발급: https://platform.openai.com → API keys (sk-... 로 시작).
OPENAI_API_KEY="sk-..."
# (선택) 조직/프로젝트 범위로 발급한 키일 때만 함께 사용:
# OPENAI_ORG_ID="org-..."
# OPENAI_PROJECT_ID="proj_..."

# ── 소셜 로그인(네이버 커스텀) — naver-auth Edge Function ─────────────────────
# NAVER_CLIENT_ID="..."               # 네이버 개발자센터 애플리케이션
# NAVER_CLIENT_SECRET="..."
