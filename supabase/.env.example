# 기억온 Supabase — Edge Functions secrets (클라이언트 미노출)
#
# 사용법: 이 파일을 supabase/.env 로 복사한 뒤 실제 값을 채우고, 배포 시:
#   cp supabase/.env.example supabase/.env
#   supabase secrets set --env-file supabase/.env
# supabase/.env 는 커밋되지 않습니다(.gitignore). 클라이언트 번들에 포함하지 마세요.

SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="<secret-key>"          # 레거시 service_role 키 대체
OPENAI_API_KEY="<openai-key>"               # STT(gpt-4o-transcribe) · LLM
CLOVA_VOICE_KEY="<clova-voice-key>"         # TTS
CLOVA_SPEECH_KEY="<clova-speech-key>"       # STT 보완 (선택)
