# 기억온 Supabase — Edge Functions secrets (클라이언트 미노출)
#
# 사용법: 이 파일을 supabase/.env 로 복사 → 실제 값 채우기 → 배포 시 등록:
#   cp supabase/.env.example supabase/.env
#   supabase secrets set --env-file supabase/.env
# supabase/.env 는 커밋되지 않습니다(.gitignore). 이 키들은 Edge Function(서버)에서만
# 쓰이며 클라이언트 번들에 절대 넣지 마세요. (Edge Function 미배포 상태면 나중에 채워도 됨.)

# ── Supabase (서버) ──────────────────────────────────────────────────────────
SUPABASE_URL="https://<서울-project-ref>.supabase.co"
SUPABASE_SECRET_KEY="<secret-key>"          # 레거시 service_role 대체 · RLS 우회 · 절대 노출 금지

# ── OpenAI (LLM · STT: gpt-4o-transcribe) ────────────────────────────────────
# 키는 1개. 인증은 HTTP 헤더  Authorization: Bearer <OPENAI_API_KEY>.
# 발급: https://platform.openai.com → API keys (sk-... 로 시작).
OPENAI_API_KEY="sk-..."
# (선택) 조직/프로젝트 범위로 발급한 키일 때만 함께 사용:
# OPENAI_ORG_ID="org-..."
# OPENAI_PROJECT_ID="proj_..."

# ── CLOVA (TTS=Voice, STT 보완=Speech Recognition) — NAVER Cloud Platform(NCP) ─
# ❗ CLOVA 는 단일 키가 아니라 "Client ID + Client Secret" 한 쌍입니다.
#    NCP 콘솔의 AI·NAVER API 애플리케이션을 등록하면 발급됩니다.
#    요청 헤더:  X-NCP-APIGW-API-KEY-ID = Client ID
#               X-NCP-APIGW-API-KEY    = Client Secret
#    한 애플리케이션에 CLOVA Voice + CLOVA Speech Recognition 을 함께 등록했다면
#    아래 한 쌍으로 TTS·STT 모두 인증됩니다(=값이 딱 2개인 경우, 대부분 이 케이스).
NCP_CLOVA_CLIENT_ID="<X-NCP-APIGW-API-KEY-ID>"
NCP_CLOVA_CLIENT_SECRET="<X-NCP-APIGW-API-KEY>"

# (선택) 서비스별로 애플리케이션을 "따로" 등록해 ID/Secret 이 서로 다르면 위 대신 아래를 사용:
# CLOVA_VOICE_CLIENT_ID="..."         # CLOVA Voice(TTS) 전용
# CLOVA_VOICE_CLIENT_SECRET="..."
# CLOVA_SPEECH_CLIENT_ID="..."        # CLOVA Speech Recognition(STT, 1분 이내) 전용
# CLOVA_SPEECH_CLIENT_SECRET="..."

# (선택) STT 를 "CLOVA Speech(장문 인식)" 제품으로 쓸 경우엔 인증 방식이 다릅니다:
#    헤더 X-CLOVASPEECH-API-KEY = 도메인 Secret Key(1개) + 전용 invoke URL.
# CLOVA_SPEECH_SECRET_KEY="..."       # 장문 인식 도메인 Secret Key
# CLOVA_SPEECH_INVOKE_URL="https://clovaspeech-gw.ncloud.com/external/v1/<...>"

# ── 소셜 로그인(네이버 커스텀) — naver-auth Edge Function ─────────────────────
# NAVER_CLIENT_ID="..."               # 네이버 개발자센터 애플리케이션
# NAVER_CLIENT_SECRET="..."
